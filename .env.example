# Copy to .env and fill in. Never commit the real .env.

TELEGRAM_BOT_TOKEN=your-botfather-token
GEMINI_API_KEY=your-gemini-key

# Comma-separated Telegram user IDs allowed to write to the log.
# Message the bot once from an unlisted account and it will tell you that account's ID.
ALLOWED_USER_IDS=111111111,222222222

# Who receives the end-of-day summary (site engineer). Usually a subset of ALLOWED_USER_IDS.
SUMMARY_CHAT_IDS=111111111

# Names (as they appear in Telegram) expected to report every day. Comma-separated.
EXPECTED_REPORTERS=Ramesh,Suresh

# Daily summary time, 24h, in TIMEZONE
SUMMARY_TIME=17:30
TIMEZONE=Asia/Kolkata

# Model name - check https://ai.google.dev/gemini-api/docs/models for the current Flash model
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Google Sheets sync (leave empty to use CSV export in ./exports)
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json

DB_PATH=site_log.db
